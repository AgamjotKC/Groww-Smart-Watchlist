# Catch-Up Environment Configuration
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DATABASE_URL=jdbc:h2:mem:catchupdb;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_URL=jdbc:h2:mem:catchupdb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Market Data Feed & Delta Engine Settings
TICK_FEED_MODE=mock
MOCK_DATA_INTERVAL_MS=2000
ACTIVE_THRESHOLD=1.0
